<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_password_form" model="ir.ui.view">
        <field name="name">password.form.form</field>
        <field name="model">password.form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="active" />
                    </group>
                    <notebook>
                        <page string="Password List" name="password">
                            <field name="device_password_ids">
                                <tree editable="top">
                                    <field name="device_id" />
                                    <field name="name" />
                                    <field name="ip_name" />
                                    <field name="user_name" />
                                    <field name="password_name" />
                                    <field name="description" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="device_id" />
                                        <field name="name" />
                                        <field name="ip_name" />
                                        <field name="user_name" />
                                        <field name="password_name" />
                                        <field name="description" />
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" option="{'post_refresh' : 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_password_form_tree" model="ir.ui.view">
        <field name="name">password.form.tree</field>
        <field name="model">password.form</field>
        <field name="arch" type="xml">
            <tree >
                <field name="partner_id" optional="show"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    

    <record id="action_password_form" model="ir.actions.act_window">
        <field name="name">Password Form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">password.form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem name="Password Form"
              id="menu_password"
              parent="menu_list"
              action="action_password_form"
              sequence="10"/>

    <record id="view_device_list_lines_tree" model="ir.ui.view">
        <field name="name">device.list.lines.tree</field>
        <field name="model">device.list.lines</field>
        <field name="arch" type="xml">
            <tree >
                <field name="device_id" />
                <field name="name" />
                <field name="ip_name" />
                <field name="user_name" />
                <field name="password_name" />
                <field name="description" />
                <field name="password_form_id" />
                <field name="id" />
                <button name="%(device_password_managment.action_update_password)d" string="Update" 
                            type="action" class="oe_highlight" context="{'active_id': active_id, 'customer_name': password_form_id}" />    
            </tree>
        </field>
    </record>
    <record id="view_device_list_lines_search" model="ir.ui.view">
        <field name="name">device.list.lines.search</field>
        <field name="model">device.list.lines</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('device_id', 'ilike', self)]"/>
                <field name="ip_name" />
                <filter string="Device" name="group_by_device_id" context="{'group_by': 'device_id'}"/>
                <filter string="Customer" name="group_by_password_form_id" context="{'group_by': 'password_form_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_device_list_lines_form" model="ir.ui.view">
        <field name="name">device.list.lines.form</field>
        <field name="model">device.list.lines</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="device_id" />
                        <field name="name" />
                        <field name="ip_name" />
                        <field name="user_name" />
                        <field name="password_name" />
                        <field name="description" />
                        <field name="password_form_id" readonly="True" />
                        <field name="id" readonly="True"/>
                    </group>
                </sheet> 
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" option="{'post_refresh' : 'recipients'}"/>
                </div>  
            </form>
        </field>
    </record>


    <record id="action_device_list_lines" model="ir.actions.act_window">
        <field name="name">Device Full List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">device.list.lines</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem name="Device Full List"
              id="menu_lines"
              parent="menu_list"
              action="action_device_list_lines"
              sequence="10"/>
</odoo>